# Example environment variables required for local development and CI builds
# Copy this file to .env.local (DO NOT commit .env.local) and fill real values for local development.

# Required for build/runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=your_auth_secret_here
GITHUB_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret

# Optional / service-specific
API_KEY_SHORTEN=your_shortener_api_key
CREATOR_ID=1
SLUG_LENGTH=6

# Database (set in CI/production). For local dev you can use a dev DB connection string.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Any other envs your deployment expects (e.g., OAuth callback URLs, analytics keys)